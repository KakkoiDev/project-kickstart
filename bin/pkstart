#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="${PROJECT_KICKSTART_DIR:-$HOME/.project-kickstart}"
REPO="KakkoiDev/project-kickstart"
BRANCH="main"
BASE_URL="https://raw.githubusercontent.com/$REPO/$BRANCH"

# Colors (disabled if not a terminal)
if [ -t 1 ]; then
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  RED='\033[0;31m'
  BOLD='\033[1m'
  NC='\033[0m'
else
  GREEN='' YELLOW='' RED='' BOLD='' NC=''
fi

info()  { printf '%s[ok]%s %s\n' "$GREEN" "$NC" "$1"; }
warn()  { printf '%s[!!]%s %s\n' "$YELLOW" "$NC" "$1"; }
error() { printf '%s[error]%s %s\n' "$RED" "$NC" "$1" >&2; exit 1; }

# --- Template registry ---
# Format: "command|source_path|output_name|internal_source|internal_output"
TEMPLATES=(
  "brief|templates/PROJECT_BRIEF_TEMPLATE.md|BRIEF.md|templates/internal/INTERNAL_PROJECT_BRIEF.md|INTERNAL_BRIEF.md"
  "scope|templates/PROJECT_SCOPING_CHECKLIST.md|SCOPING_CHECKLIST.md|templates/internal/INTERNAL_PROJECT_SCOPING.md|INTERNAL_SCOPING.md"
  "feature|templates/FEATURE_SCOPING_CHECKLIST.md|FEATURE_CHECKLIST.md|templates/internal/INTERNAL_FEATURE_SCOPING.md|INTERNAL_FEATURE.md"
  "trd|templates/TRD_TEMPLATE.md|TRD.md|templates/internal/INTERNAL_TRD.md|INTERNAL_TRD.md"
  "change|templates/CHANGE_REQUEST.md|CHANGE_REQUEST.md|templates/internal/INTERNAL_CHANGE_REQUEST.md|INTERNAL_CHANGE_REQUEST.md"
)

# --- Flags ---
FORCE=false
INTERNAL=false
OUT_DIR="."

# --- Functions ---

resolve_file() {
  local rel_path="$1" dest="$2"
  local local_path="$INSTALL_DIR/$rel_path"

  if [ -f "$local_path" ]; then
    cp "$local_path" "$dest"
    return 0
  fi

  local url="$BASE_URL/$rel_path"
  if command -v curl &>/dev/null; then
    curl -fsSL "$url" -o "$dest" 2>/dev/null && return 0
  elif command -v wget &>/dev/null; then
    wget -qO "$dest" "$url" 2>/dev/null && return 0
  fi

  return 1
}

copy_template() {
  local cmd="$1"

  for entry in "${TEMPLATES[@]}"; do
    IFS='|' read -r name src out int_src int_out <<< "$entry"
    if [ "$name" = "$cmd" ]; then
      local dest="$OUT_DIR/$out"

      mkdir -p "$OUT_DIR"

      if [ -f "$dest" ] && [ "$FORCE" = false ]; then
        warn "$out already exists. Use --force to overwrite."
      elif resolve_file "$src" "$dest"; then
        info "$out"
      else
        error "Failed to fetch $src"
      fi

      if [ "$INTERNAL" = true ]; then
        local int_dest="$OUT_DIR/$int_out"
        if [ -f "$int_dest" ] && [ "$FORCE" = false ]; then
          warn "$int_out already exists. Use --force to overwrite."
        elif resolve_file "$int_src" "$int_dest"; then
          info "$int_out"
        else
          error "Failed to fetch $int_src"
        fi
      fi

      return 0
    fi
  done

  error "Unknown template: $cmd"
}

cmd_init() {
  for entry in "${TEMPLATES[@]}"; do
    IFS='|' read -r name _ _ _ _ <<< "$entry"
    copy_template "$name"
  done
}

cmd_list() {
  printf '%sAvailable templates:%s\n\n' "$BOLD" "$NC"
  printf '  %-12s %-40s %s\n' "Command" "Source" "Copies as"
  printf '  %-12s %-40s %s\n' "-------" "------" "---------"
  for entry in "${TEMPLATES[@]}"; do
    IFS='|' read -r name src out _ _ <<< "$entry"
    printf '  %-12s %-40s %s\n' "$name" "$src" "$out"
  done
  printf '\n  Use --internal to also copy internal companion templates.\n'
}

cmd_update() {
  printf "Updating local cache in %s/\n" "$INSTALL_DIR"
  for entry in "${TEMPLATES[@]}"; do
    IFS='|' read -r name src _ int_src _ <<< "$entry"
    local dest="$INSTALL_DIR/$src"
    local int_dest="$INSTALL_DIR/$int_src"
    mkdir -p "$(dirname "$dest")" "$(dirname "$int_dest")"

    local url="$BASE_URL/$src"
    if command -v curl &>/dev/null; then
      curl -fsSL "$url" -o "$dest" 2>/dev/null && info "$src" || warn "Failed: $src"
    elif command -v wget &>/dev/null; then
      wget -qO "$dest" "$url" 2>/dev/null && info "$src" || warn "Failed: $src"
    fi

    url="$BASE_URL/$int_src"
    if command -v curl &>/dev/null; then
      curl -fsSL "$url" -o "$int_dest" 2>/dev/null && info "$int_src" || warn "Failed: $int_src"
    elif command -v wget &>/dev/null; then
      wget -qO "$int_dest" "$url" 2>/dev/null && info "$int_src" || warn "Failed: $int_src"
    fi
  done
  info "Cache updated."
}

cmd_help() {
  cat <<'HELP'
pkstart - Copy project-kickstart templates into your project

Usage: pkstart <command> [flags]

Commands:
  init              Copy all 5 templates
  brief             Copy project brief
  scope             Copy project scoping checklist
  feature           Copy feature scoping checklist
  trd               Copy TRD template
  change            Copy change request template
  list              List available templates
  update            Re-download templates from GitHub to local cache

Flags:
  --internal        Also copy the internal companion template(s)
  --force           Overwrite existing files without prompting
  --dir <path>      Output directory (default: ./)
  --help, -h        Show this help

Examples:
  pkstart init                    # All templates into current dir
  pkstart brief                   # Just the brief
  pkstart trd --internal          # TRD + internal companion
  pkstart init --force --internal # Everything, overwrite existing
HELP
}

# --- Parse args ---
CMD=""
POSITIONAL=()

while [ $# -gt 0 ]; do
  case "$1" in
    --force)    FORCE=true; shift ;;
    --internal) INTERNAL=true; shift ;;
    --dir)      OUT_DIR="${2:?--dir requires a path}"; shift 2 ;;
    --help|-h)  cmd_help; exit 0 ;;
    -*)         error "Unknown flag: $1" ;;
    *)          POSITIONAL+=("$1"); shift ;;
  esac
done

CMD="${POSITIONAL[0]:-}"

if [ -z "$CMD" ]; then
  cmd_help
  exit 0
fi

# --- Dispatch ---
case "$CMD" in
  init)    cmd_init ;;
  list)    cmd_list ;;
  update)  cmd_update ;;
  brief|scope|feature|trd|change) copy_template "$CMD" ;;
  help)    cmd_help ;;
  *)       error "Unknown command: $CMD. Run 'pkstart --help' for usage." ;;
esac
